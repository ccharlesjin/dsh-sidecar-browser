{
  "name": "dsh-browser-live",
  "version": "1.1.0",
  "description": "Native Electron webview browser for the DeepSeek Harness right sidebar.",
  "license": "MIT",
  "author": "DSH Browser Live contributors",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "native-bridge.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "policy.json",
    "install.ps1",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "electron",
    "browser",
    "webview",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check native-bridge.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
