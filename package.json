{
  "name": "dsh-sidecar-browser",
  "version": "1.1.7",
  "description": "DSH Sidecar Browser: a model-driven companion browser in the DeepSeek Harness right sidebar.",
  "license": "MIT",
  "author": "DSH Sidecar Browser contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccharlesjin/dsh-sidecar-browser.git"
  },
  "homepage": "https://github.com/ccharlesjin/dsh-sidecar-browser#readme",
  "bugs": {
    "url": "https://github.com/ccharlesjin/dsh-sidecar-browser/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "native-bridge.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "policy.json",
    "install.ps1",
    "migrate-from-local.ps1",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "electron",
    "browser",
    "webview",
    "sidecar",
    "agent",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check native-bridge.cjs",
    "test:scope": "node test/stable-id-scope.cjs",
    "test:bugs": "node test/bugfix-check.cjs",
    "test:session": "node test/session-check.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
